{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "frames",
    "notes"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "failed"
      ]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
